{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aspa.local/schemas/document-registry.schema.json",
  "title": "ASPA document sidecar registry",
  "type": "object",
  "required": ["meta", "release_approvals", "documents"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schema_version", "sidecar_version"],
      "properties": {
        "schema_version": {"const": "1.0.0"},
        "sidecar_version": {"const": "1.0.0"}
      }
    },
    "release_approvals": {
      "type": "object",
      "additionalProperties": {"type": "boolean"}
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id", "title", "kind", "status", "source_dir", "evidence_refs", "immutable"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^[A-Z]+(?:-[A-Z]+)*-[0-9]{3}$"},
          "title": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "source_dir": {"type": "string", "minLength": 1},
          "entrypoint": {"type": ["string", "null"]},
          "evidence_refs": {
            "type": "array",
            "items": {"type": "string", "pattern": "^(S[0-9]{3,}|ST[0-9]{3,})$"},
            "uniqueItems": true
          },
          "immutable": {"type": "boolean"},
          "immutable_source_inventory": {
            "type": "object",
            "required": ["path", "sha256"],
            "properties": {
              "path": {"type": "string", "pattern": "^data/immutable-manifests/[A-Z0-9_-]+\\.json$"},
              "sha256": {"type": "string", "pattern": "^[A-F0-9]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
