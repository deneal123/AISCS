\newlabel{tab:auditfull}{{II}{2}{Consolidated audit of the automatic supervision. ``Reference'' states what the metric is measured against: an automatic cross-check (upper block, corpus scale) or human ground truth from a small manual validation (lower block; 100 posts $+$ sampled pairs/merges, one annotator). $n$ is the audited population. A large multi-annotator audit with $\kappa $ remains beyond resources}{table.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Headroom curve: the $+$pairs gain on FG-NET large-gap shrinks monotonically as the frozen backbone strengthens, crossing zero for strong saturated models.}}{3}{figure.1}\protected@file@percent }
\newlabel{fig:headroom}{{1}{3}{Headroom curve: the $+$pairs gain on FG-NET large-gap shrinks monotonically as the frozen backbone strengthens, crossing zero for strong saturated models}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Data-scaling law: external (FG-NET large-gap) and internal (our.25+) ROC-AUC vs.\ the number of training identities (log scale). Roughly 96\% of the gain is reached at 10\% of identities; shaded bands are $\pm $1 std over three seeds and dashed lines are the frozen baselines.}}{3}{figure.2}\protected@file@percent }
\newlabel{fig:scaling}{{2}{3}{Data-scaling law: external (FG-NET large-gap) and internal (our.25+) ROC-AUC vs.\ the number of training identities (log scale). Roughly 96\% of the gain is reached at 10\% of identities; shaded bands are $\pm $1 std over three seeds and dashed lines are the frozen baselines}{figure.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Objective comparison: contrastive, ArcFace and CosFace coincide on cross-age transfer; SphereFace (hardest to optimize, no $\lambda $-annealing) trails. ArcFace/CosFace forget slightly less on easy benchmarks.}}{3}{figure.3}\protected@file@percent }
\newlabel{fig:sota}{{3}{3}{Objective comparison: contrastive, ArcFace and CosFace coincide on cross-age transfer; SphereFace (hardest to optimize, no $\lambda $-annealing) trails. ArcFace/CosFace forget slightly less on easy benchmarks}{figure.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Apparent-demographic audit: frozen vs.\ $+$pairs ROC-AUC across apparent gender/age strata. Every stratum improves; the largest gain is for the youngest (0--17) group, where the frozen baseline is weakest. Error bars are the 95\% paired-bootstrap CI of the gain and $n$ is positive pairs per stratum (the sparse 45+ stratum, $n{=}153$, has a correspondingly wide interval).}}{3}{figure.4}\protected@file@percent }
\newlabel{fig:fairness}{{4}{3}{Apparent-demographic audit: frozen vs.\ $+$pairs ROC-AUC across apparent gender/age strata. Every stratum improves; the largest gain is for the youngest (0--17) group, where the frozen baseline is weakest. Error bars are the 95\% paired-bootstrap CI of the gain and $n$ is positive pairs per stratum (the sparse 45+ stratum, $n{=}153$, has a correspondingly wide interval)}{figure.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces External generalization. The $+$pairs gain over the frozen baseline (with 95\% CIs) holds across three independent evaluations---FG-NET large-gap, a child$\leftrightarrow $adult FG-NET subset, and the cross-platform Reddit set---each well above chance. The gain is largest on the in-protocol FG-NET sets and smaller (but positive) on the noisier cross-platform Reddit set.}}{4}{figure.5}\protected@file@percent }
\newlabel{fig:external}{{5}{4}{External generalization. The $+$pairs gain over the frozen baseline (with 95\% CIs) holds across three independent evaluations---FG-NET large-gap, a child$\leftrightarrow $adult FG-NET subset, and the cross-platform Reddit set---each well above chance. The gain is largest on the in-protocol FG-NET sets and smaller (but positive) on the noisier cross-platform Reddit set}{figure.5}{}}
