{
  "name": "gpthub-frontend",
  "homepage": "/",
  "version": "1.0.0",
  "private": true,
  "sideEffects": [
    "*.css",
    "src/index.js",
    "src/utils/polyfills.js"
  ],
  "dependencies": {
    "@chakra-ui/icons": "^2.1.1",
    "@chakra-ui/react": "^2.8.2",
    "@emotion/react": "^11.11.1",
    "@emotion/styled": "^11.14.1",
    "axios": "^1.18.1",
    "framer-motion": "^10.16.4",
    "js-cookie": "^3.0.8",
    "katex": "^0.17.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-icons": "^4.12.0",
    "react-markdown": "^10.1.0",
    "react-router": "^6.30.1",
    "react-router-dom": "^6.30.1",
    "react-scripts": "^5.0.1",
    "react-select": "^5.8.0",
    "react-select-async-paginate": "^0.7.3",
    "react-syntax-highlighter": "^16.1.0",
    "recharts": "^2.10.3",
    "rehype-katex": "^7.0.1",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "three": "^0.169.0",
    "web-vitals": "^3.5.2",
    "ws": "^8.18.3"
  },
  "scripts": {
    "start": "craco start",
    "build": "craco build",
    "build:analyze": "GENERATE_SOURCEMAP=true craco build && npx source-map-explorer 'build/static/js/*.js' --html analyze-report.html",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest tests/unit",
    "test:integration": "jest tests/integration",
    "test:e2e": "npx playwright test --config=tests/e2e/playwright.config.js",
    "eject": "react-scripts eject",
    "lint": "npx eslint \"src/**/*.{js,jsx}\"",
    "format": "npx prettier --write \"src/**/*.{js,jsx,css,md}\"",
    "axe": "node scripts/run-axe.js",
    "e2e:install": "npx playwright install --with-deps",
    "e2e:run": "npx playwright test --project=chromium --config=tests/e2e/playwright.config.js",
    "e2e:all": "npx playwright test --config=tests/e2e/playwright.config.js",
    "e2e:desktop": "npx playwright test --project=chromium --project=firefox --project=webkit --config=tests/e2e/playwright.config.js",
    "e2e:mobile": "npx playwright test --project=mobile-chrome --project=mobile-safari --config=tests/e2e/playwright.config.js",
    "test:a11y": "npx playwright test tests/e2e/ui-contract.spec.js --config=tests/e2e/playwright.config.js --project=chromium",
    "test:e2e:work": "npx playwright test tests/e2e/work-hub.spec.js --config=tests/e2e/playwright.config.js --project=chromium --project=tablet --project=mobile-chrome",
    "verify:premium": "uv run --project ../agents --frozen python ../scripts/check_frontend_ui_contract.py",
    "test:all": "npm run test:unit && npm run test:integration && npm run e2e:run"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ],
    "globals": {
      "process": "readonly"
    }
  },
  "browserslist": {
    "production": [
      "last 2 Chrome versions",
      "last 2 Firefox versions",
      "last 2 Safari versions",
      "last 2 Edge versions",
      "not dead"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "proxy": "http://backend:8000",
  "description": "Frontend for mlservice",
  "main": "index.js",
  "keywords": [
    "mlservice",
    "fastapi",
    "react"
  ],
  "author": "dfvolkhin@edu.hse.ru",
  "license": "MIT",
  "devDependencies": {
    "@craco/craco": "^7.1.0",
    "@playwright/test": "^1.40.0",
    "@testing-library/jest-dom": "^5.17.0",
    "@testing-library/react": "^13.4.0",
    "@testing-library/user-event": "^13.5.0",
    "axe-core": "^4.11.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest-dom": "^5.5.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-testing-library": "^7.11.0",
    "globals": "^16.4.0",
    "identity-obj-proxy": "^3.0.0",
    "playwright": "^1.40.0",
    "puppeteer-core": "^24.31.0"
  },
  "overrides": {
    "nth-check": "^2.1.1",
    "postcss": "^8.4.31",
    "yaml": "^2.9.0",
    "ws": "^8.18.3",
    "cross-spawn": "^7.0.6",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "semver": "^7.6.3",
    "serialize-javascript": "^6.0.2",
    "node-forge": "^1.3.1"
  }
}
