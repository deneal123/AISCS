PORT=8080
RESEARCH_DATA_DIR=./data

# Optional host-side knowledge endpoints; credentials belong in the ignored
# .knowledge/runtime.env (never commit that file).
RESEARCH_KNOWLEDGE_DIR=./.knowledge
RESEARCH_EMBEDDING_URL=http://127.0.0.1:8092
RESEARCH_QDRANT_URL=http://127.0.0.1:6335
RESEARCH_NEO4J_URL=bolt://127.0.0.1:7689
RESEARCH_NEO4J_USER=neo4j
# Runtime file keys: RESEARCH_EMBEDDING_KEY, RESEARCH_NEO4J_PASSWORD,
# AGENTS__GIGACHAT_*; container CA: /run/certs/gigachat-ca.pem.
# The model is pinned to gigachat:EmbeddingsGigaR (2560 dimensions, 4096 tokens).
