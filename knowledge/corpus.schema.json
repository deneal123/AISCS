{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portable registered dissertation texts",
  "type": "object",
  "required": ["generated_at", "entries"],
  "properties": {
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source_id", "status", "reason", "primary_urls", "completeness", "identity_verified"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^S[0-9]+$"},
          "status": {"enum": ["available", "missing", "unavailable", "needs_ocr", "rejected", "error"]},
          "sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
          "version": {"type": ["string", "null"]},
          "primary_urls": {"type": "array", "items": {"type": "string"}},
          "identity_verified": {"type": "boolean"},
          "completeness": {"enum": ["full_text", "partial_text", "unavailable"]}
        }
      }
    }
  }
}
