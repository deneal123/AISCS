# ════════════════════════════════════════════════════════════════════════════
#  AISCS — шаблон переменных окружения
#  Скопируйте в .env.dev / .env.prod и заполните секреты. Формат: KEY=value.
#  docker compose читает построчно; порядок ключей не важен — секции для людей.
#
#  Конфигураций ровно две, и обе поднимают генератор на видеокарте:
#    docker-compose.dev.yaml  — разработка (порты наружу, Mailpit, MinIO)
#    docker-compose.yaml      — прод (наружу только nginx, объектное хранилище S3)
#
#  Порядок секций: docker → порты → сервис → аутентификация → CORS → хранилище →
#  базы и очереди → почта → ручки IDE → генератор → биллинг → платежи → админ →
#  уведомления. Ключи, читаемые кодом, но не доставленные в compose, объявлены
#  здесь же: гейт scripts/check_env_contract.py сверяет обе половины.
# ════════════════════════════════════════════════════════════════════════════

# ═══ 1. Docker / сборка ═════════════════════════════════════════════════════
# Режим выбирается флагом сборки (build.sh --dev | --prod), а не ключом в env:
# MODE и APP_TAG удалены как мёртвые — их не читал ни один скрипт.
UVICORN_WORKERS=2

# ═══ 2. Хостовые порты ══════════════════════════════════════════════════════
# Публикации на хост (меняйте, если заняты другим стеком). Внутри docker-сети
# сервисы общаются по стандартным портам — меняются только host-публикации.
# При смене BACKEND_PORT синхронизируйте SERVICE__REACT_APP_*_BASE_URL ниже.
# ⚠️ Только для DEV: в prod-compose наружу смотрит nginx, эти ключи там не нужны.
BACKEND_PORT=8000
FRONTEND_PORT=3000
POSTGRES_HOST_PORT=5432
MAILPIT_PORT=8027
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ═══ 2b. nginx (только prod) ═════════════════════════════════════════════════
# В dev этих ключей не читает ни один сервис: наружу смотрят опубликованные
# порты. В prod nginx терминирует TLS и проксирует /api и /ws.
# NGINX_PUBLISH_HTTPS — адрес публикации на ХОСТЕ (127.0.0.1:8447 значит «только
# через внешний edge-прокси»); PUBLIC_HTTPS_PORT — порт в БРАУЗЕРНОМ адресе.
APP_DOMAIN=your-domain.example.com
NGINX_PUBLISH_HTTPS=127.0.0.1:8447
PUBLIC_HTTPS_PORT=443

# ═══ 3. API-сервис ══════════════════════════════════════════════════════════
# SERVICE__APP_DOMAIN — домен, на котором живёт приложение. От него зависит
# проверка безопасности старта: AUTH__AUTH_MODE=dev разрешён ТОЛЬКО на локальном
# домене (localhost, *.local, *.test, *.internal).
SERVICE__LOGGING_LEVEL=DEBUG
SERVICE__SERVER_PORT=8000
SERVICE__NAME=service-api
SERVICE__APP_DOMAIN=your-domain.example.com
SERVICE__ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001
SERVICE__NGINX_PORT=80
SERVICE__REACT_APP_API_BASE_URL=http://localhost:8000
SERVICE__REACT_APP_WS_BASE_URL=ws://localhost:8000
SERVICE__REACT_APP_ENABLE_ADMIN_UI=true

# Прикладной профиль: simulation — приложение живёт ради симулятора ЦНС, и все
# прочие ручки отвечают 404. Это единственный профиль, который сейчас поддержан:
# сайдкары чата (agents, workspace, whisper, video, graphify, opendataloader,
# duckdb, memos, ldr, searxng) из проекта удалены.
SERVICE__APPLICATION_PROFILE=simulation
REACT_APP_APPLICATION_PROFILE=simulation

# ═══ 4. Аутентификация ══════════════════════════════════════════════════════
# AUTH__SECRET и AUTH__ALGORITHM обязательны без дефолта: без них backend не
# стартует. AUTH__AUTH_MODE объявлен явно, потому что его дефолт — «prod»:
# «не указать» здесь значит выбрать prod, а рядом AUTH__DEV_MODE.
# ⚠️ Пара AUTH__DEV_MODE=true + AUTH__AUTH_MODE=prod роняет старт намеренно:
# кука ушла бы Secure=False на боевом домене.
AUTH__SECRET=your-jwt-secret-key-here-change-in-production
AUTH__ALGORITHM=HS256
AUTH__JWT_EXP_HOURS=24
AUTH__AUTH_MODE=prod
# Только dev: insecure-cookie и dev test-token. В проде ключа быть не должно.
AUTH__DEV_MODE=false

# ═══ 5. CORS ════════════════════════════════════════════════════════════════
# ⚠️ Имя ключа — CORS__ALLOW_ORIGINS (двойное подчёркивание). При
# AUTH__AUTH_MODE=prod пустой список роняет старт: браузер не должен ходить на
# чужой origin с нашими куками.
CORS__ALLOW_ORIGINS=["https://your-domain.example.com","http://localhost:3000"]

# ═══ 6. Хранилище ═══════════════════════════════════════════════════════════
# local — файлы на диске (том инфраструктуры), minio — объектное хранилище.
STORAGE__ROOT=/var/lib/app/storage
STORAGE__BACKEND=local

# ═══ 7. Базы и очереди ══════════════════════════════════════════════════════
PG__USER=postgres
PG__PASSWORD=your-postgres-password-here
PG__HOST=postgres
PG__PORT=5432
PG__DB=main
REDIS__ENABLED=true
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=changeme
REDIS__SESSION_PREFIX=session
REDIS__SESSION_TTL_SECONDS=3600
REDIS__CACHE_PREFIX=cache
REDIS__CACHE_DEFAULT_TTL_SECONDS=300
REDIS__PROFILE_CACHE_TTL_SECONDS=900
# Образ MinIO локальной сборки: в dev он собирается из docker/minio, чтобы
# поведение консоли и healthcheck не зависело от версии из реестра.
MINIO_DEV_IMAGE=minio/minio:RELEASE.2025-09-07T16-13-09Z
MINIO__ENDPOINT=minio:9000
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin
MINIO__BUCKET=mlops-files
MINIO__REGION=us-east-1
MINIO__SECURE=false
MINIO__PUBLIC_ENDPOINT=http://localhost:9000
MINIO__RETRY_ATTEMPTS=3
MINIO__RETRY_BACKOFF=0.5
MINIO__PRESIGN_EXPIRY=3600
# Очереди: maintenance (обслуживание) и simulation (прогоны ЦНС). Очередь agents
# удалена вместе с сайдкаром; CELERY__QUEUES оставлен для совместимости с
# умолчанием Celery и не задаёт список воркеров (его задаёт command в compose).
CELERY__BROKER_URL=redis://:${REDIS__PASSWORD}@redis:6379/0
CELERY__RESULT_BACKEND=redis://:${REDIS__PASSWORD}@redis:6379/1
CELERY__QUEUES=default
PRICING_SYNC_SCHEDULE_SECONDS=86400

# ═══ 8. Почта ═══════════════════════════════════════════════════════════════
# dev перекрывает эти значения на Mailpit (x-dev-mail в docker-compose.dev.yaml).
MAIL__ENABLED=false
MAIL__HOST=smtp.mail.selcloud.ru
MAIL__PORT=1127
MAIL__USE_TLS=true
MAIL__START_TLS=true
MAIL__LOGIN=
MAIL__PASSWORD=
MAIL__FROM_ADDRESS=no-reply@incellcorp.ru
MAIL__FROM_NAME=GPTHub
MAIL__CODE_LENGTH=6
MAIL__CODE_TTL_SECONDS=600

# ═══ 9. Ручки IDE (harness) ═════════════════════════════════════════════════
# HARNESS__* — то, что видит сервис. DEV_HARNESS__* — то, что compose
# подставляет в dev-контейнер (default false: ручки опасны, включать осознанно).
HARNESS__IDE_ENABLED=true
HARNESS__IDE_COMMANDS_ENABLED=true
HARNESS__PDF_ENABLED=true
HARNESS__DISPATCH_ENABLED=true
DEV_HARNESS__IDE_ENABLED=true
DEV_HARNESS__IDE_COMMANDS_ENABLED=true
DEV_HARNESS__PDF_ENABLED=true

# ═══ 10. Генератор ЦНС (он же симулятор, GPU) ═══════════════════════════════
# Один образ на обе конфигурации, target gpu-runtime. Кэш геометрии обязателен:
# без него batch-путь отвергает gpu-fused конфигурацию (_field_geometry_cache
# в generator/service/infrastructure/execution/process.py).
#
# GENERATOR_TOKEN — общий секрет backend→generator. Пустой токен роняет старт
# генератора: (см. generator/service/settings/__init__.py).
GENERATOR_TOKEN=
GENERATOR_URL=http://generator:8090
# GPU-путь: gpu (batch-солвер на видеокарте) или cpu. gpu-fused требует кэш.
GENERATOR_FIELD_BACKEND=gpu
GENERATOR_FIELD_WORKERS=2
GENERATOR_MORPHOLOGY_SPATIAL_WORKERS=4
#
# --- Пути к данным на хосте (bind-mount, только чтение, кроме диагностики) ---
# Домен MaleCNS целиком: морфологии, индексы, кэш геометрии, синапсы, нейропиль.
GENERATOR_GEOMETRY_CACHE_HOST_PATH=../.data/male-cns/geometry-cache-v1-zlib
GENERATOR_MORPHOLOGY_EXISTING_PATH=../.data/male-cns/morphology
GENERATOR_MORPHOLOGY_FULL_PATH=../.data/male-cns/full-morphology
GENERATOR_MORPHOLOGY_INDEX_PATH=../.data/male-cns/morphology-index
GENERATOR_CNS_OVERVIEW_PATH=../.data/male-cns/overview-v1
GENERATOR_SYNAPSE_PATH=../.data/male-cns/synapses
GENERATOR_SOURCE_PAIR_PATH=../.data/male-cns/source-pairs-v2
GENERATOR_SOURCE_DIAGNOSTICS_PATH=../.data/male-cns/source-diagnostics
GENERATOR_NEUROPIL_PATH=../.data/male-cns/neuropil-lod-v1
# Отпечаток манифеста кэша геометрии: привязан к graph_sha256 набора индексов.
# Не совпадёт — генератор откажется стартовать, а не посчитает не то.
GENERATOR_GEOMETRY_CACHE_MANIFEST_SHA256=bf6374d275de2c52b908fa1b7847d3f7a97be401adc70e9a6ad0ca658ab0a725

# ═══ 11. Биллинг ════════════════════════════════════════════════════════════
BILLING__CREDIT_UNIT_RUB=0.01
BILLING__MARGIN_MULTIPLIER=2.5
BILLING__MIN_MARGIN=2.0
BILLING__COST_GUARD_WARNING_EVENTS=1
BILLING__COST_GUARD_CRITICAL_EVENTS=5
BILLING__COMPLEXITY_FACTOR_COMPLEX=1.15
BILLING__MIN_CREDITS_PER_REQUEST=1
BILLING__RESERVE_SAFETY=1.2
BILLING__FREE_PLAN_CREDITS=10000
BILLING__DEFAULT_PRICE_IN_RUB_PER_1K=2.0
BILLING__DEFAULT_PRICE_OUT_RUB_PER_1K=6.0
BILLING__ABUSE_SPEND_THRESHOLD_CREDITS=200000
BILLING__ABUSE_SPEND_WINDOW_SECONDS=3600

# ═══ 12. Платежи ════════════════════════════════════════════════════════════
# mock — платёжный провайдер-заглушка для разработки; yookassa — боевой.
PAYMENTS__PROVIDER=mock
PAYMENTS__WEBHOOK_SECRET=change-me-any-nonempty-string-for-mock
PAYMENTS__SUCCESS_URL=http://localhost:3000/billing/success
PAYMENTS__CANCEL_URL=http://localhost:3000/billing
PAYMENTS__YOOKASSA_SHOP_ID=
PAYMENTS__YOOKASSA_SECRET_KEY=
PAYMENTS__RECEIPT_ENABLED=false
PAYMENTS__RECEIPT_VAT_CODE=1
PAYMENTS__RECEIPT_PAYMENT_SUBJECT=service
PAYMENTS__RECEIPT_PAYMENT_MODE=full_payment
PAYMENTS__RECEIPT_TAX_SYSTEM_CODE=0

# ═══ 13. Админ-панель ══════════════════════════════════════════════════════
ADMIN__SETTINGS_OVERLAY_TTL_SEC=30
ADMIN__ADMIN_ROLE_CACHE_TTL_SEC=30

# ═══ 14. Уведомления ════════════════════════════════════════════════════════
NOTIFICATIONS__ENABLED=true
NOTIFICATIONS__APP_URL=https://gpthub.ru
NOTIFICATIONS__SUBSCRIPTION_NOTICE_DAYS=3
NOTIFICATIONS__LOW_CREDITS_THRESHOLD=0.1
NOTIFICATIONS__IDLE_DAYS=30
NOTIFICATIONS__MAX_PER_WINDOW=1
NOTIFICATIONS__FREQUENCY_WINDOW_DAYS=7
