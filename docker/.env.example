# ════════════════════════════════════════════════════════════════════════════
#  GPTHub — шаблон переменных окружения
#  Скопируйте в .env.dev / .env.prod и заполните секреты. Формат: KEY=value.
#  docker compose читает построчно; порядок ключей не важен — секции для людей.
# ════════════════════════════════════════════════════════════════════════════

# ═══ 1. Docker / сборка ═════════════════════════════════════════════════════
# ⚠️ APP_TAG и APP_DOCKERHUB_REPO УДАЛЕНЫ: мёртвые ключи. Проверено поиском по
# docker/, Makefile и .github — они не читались НИГДЕ. Остались от релизного пути
# (тегирование и публикация образа), который не работал ни разу и удалён целиком.
# Публикации в реестр в проекте нет; появится — заводить ключи заново и осознанно.
MODE=dev

# ═══ 2. Хостовые порты ══════════════════════════════════════════════════════
# Публикации на хост (меняйте, если заняты другим стеком). Внутри docker-сети
# сервисы общаются по стандартным портам — меняются только host-публикации.
# При смене BACKEND_PORT синхронизируйте SERVICE__REACT_APP_*_BASE_URL ниже.
# ⚠️ Только для DEV: host-публикации портов есть лишь в docker-compose.dev.yaml.
# В prod-compose эти переменные не используются ни разу — наружу смотрит nginx.
BACKEND_PORT=8000
FRONTEND_PORT=3000
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# ═══ 3. API-сервис ══════════════════════════════════════════════════════════
SERVICE__LOGGING_LEVEL=DEBUG
SERVICE__SERVER_PORT=8000
SERVICE__NAME=service-api
SERVICE__APP_DOMAIN=your-domain.example.com
SERVICE__ADMIN_USER_IDS=00000000-0000-0000-0000-000000000001
SERVICE__NGINX_PORT=80
# ⚠️ Эти два ключа — ТОЛЬКО ДЛЯ DEV, и localhost здесь не опечатка. В dev фронт
# живёт на 3000, бэкенд на 8000, и `npm start` читает их в рантайме. В PROD они не
# применяются вовсе и применяться не должны: бандл раздаётся nginx'ом и ходит на
# свой origin, а зашитый в него `localhost:8000` увёл бы браузер пользователя на
# его собственную машину. Подробности — в комментарии frontend/docker/Dockerfile.
SERVICE__REACT_APP_API_BASE_URL=http://localhost:8000
SERVICE__REACT_APP_WS_BASE_URL=ws://localhost:8000
SERVICE__REACT_APP_ENABLE_ADMIN_UI=true

# ═══ 4. Аутентификация ══════════════════════════════════════════════════════
AUTH__SECRET=your-jwt-secret-key-here-change-in-production
AUTH__ALGORITHM=HS256
AUTH__JWT_EXP_HOURS=24
# ⚠️ ШАБЛОН PROD-БЕЗОПАСЕН ПО УМОЛЧАНИЮ, И ЭТО НАМЕРЕННО. `_assert_prod_safety`
# отвергает ДВЕ комбинации, и шаблон не должен кодировать ни одну:
#   1) AUTH__DEV_MODE=true при AUTH__AUTH_MODE=prod — кука ушла бы Secure=False;
#   2) AUTH__AUTH_MODE=dev при НЕ-локальном SERVICE__APP_DOMAIN — dev включает
#      анонимный WS-вход, dev test-token и debug-роуты на публичном домене.
# Здесь домен — публичный placeholder, поэтому auth_mode=prod, а dev_mode закомментирован.
#
# ДЛЯ ЛОКАЛЬНОЙ КОПИИ: SERVICE__APP_DOMAIN=localhost, AUTH__AUTH_MODE=dev,
# AUTH__DEV_MODE=True — все три вместе, иначе старт не пройдёт.
AUTH__AUTH_MODE=prod
# AUTH__DEV_MODE=True   # ТОЛЬКО для локальной копии (см. блок выше)

# ═══ 5. CORS ════════════════════════════════════════════════════════════════
# JSON-массив доменов; в продакшне укажите ваш домен.
CORS__ALLOW_ORIGINS=["https://your-domain.example.com","http://localhost:3000"]

# ═══ 6. Хранилище файлов ════════════════════════════════════════════════════
STORAGE__ROOT=/var/lib/app/storage
STORAGE__BACKEND=local  # local|minio

# ═══ 7. Базы данных и очереди — Postgres · Redis · MinIO · Celery ═══════════
PG__USER=postgres
PG__PASSWORD=your-postgres-password-here
PG__HOST=postgres
PG__PORT=5432
PG__DB=main

REDIS__ENABLED=true
REDIS__HOST=redis
REDIS__PORT=6379
REDIS__DB=0
REDIS__PASSWORD=changeme
REDIS__SESSION_PREFIX=session
REDIS__SESSION_TTL_SECONDS=3600
REDIS__CACHE_PREFIX=cache
REDIS__CACHE_DEFAULT_TTL_SECONDS=300
REDIS__PROFILE_CACHE_TTL_SECONDS=900

# MinIO — используется при STORAGE__BACKEND=minio.
# ⚠️ minioadmin/minioadmin — общеизвестный дефолт MinIO. Он оставлен здесь, чтобы
# локальный старт работал «из коробки», но в ПРОДЕ его надо сменить: с ним хранилище
# открыто всем, кто знает адрес. Прод-компоуз теперь отказывается подниматься, если
# переменные не заданы вовсе, — но подставленное отсюда значение он отличить не может.
MINIO__ENDPOINT=minio:9000  # Use "localhost:9000" for local development
MINIO__ACCESS_KEY=minioadmin
MINIO__SECRET_KEY=minioadmin
MINIO__BUCKET=mlops-files
MINIO__REGION=us-east-1
MINIO__SECURE=false
MINIO__PUBLIC_ENDPOINT=http://localhost:9000  # External URL for presigned URLs
MINIO__RETRY_ATTEMPTS=3
MINIO__RETRY_BACKOFF=0.5
MINIO__PRESIGN_EXPIRY=3600

CELERY__BROKER_URL=amqp://guest:guest@rabbitmq:5672//
CELERY__RESULT_BACKEND=redis://redis:6379/1
CELERY__QUEUES=default
# Periodic maintenance: reload RouterAI/OpenRouter rates once per day.
PRICING_SYNC_SCHEDULE_SECONDS=86400

# ═══ 8. LLM-провайдеры ══════════════════════════════════════════════════════
AGENTS__LLM_PROVIDER=openrouter  # mws|openai|openrouter|gigachat|routerai (mws — без биллинга)

# MWS GPT (primary по умолчанию)
AGENTS__MWS_API_KEY=your-mws-gpt-api-key-here
AGENTS__MWS_BASE_URL=https://api.gpt.mws.ru/v1
AGENTS__MWS_TIMEOUT_SEC=240
AGENTS__MWS_MODELS_CACHE_TTL_SEC=180

# OpenAI (optional)
AGENTS__OPENAI_API_KEY=
AGENTS__OPENAI_BASE_URL=

# OpenRouter (optional) — также питает self-hosted MemOS (см. §10)
AGENTS__OPENROUTER_API_KEY=
AGENTS__OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
AGENTS__OPENROUTER_TIMEOUT_SEC=20
AGENTS__OPENROUTER_MODELS_CACHE_TTL_SEC=180

# RouterAI (optional, OpenAI-compatible — https://routerai.ru/api/v1)
AGENTS__ROUTERAI_API_KEY=
AGENTS__ROUTERAI_BASE_URL=https://routerai.ru/api/v1
AGENTS__ROUTERAI_TIMEOUT_SEC=45
AGENTS__ROUTERAI_MODELS_CACHE_TTL_SEC=180

# GigaChat (Сбер, optional). Авторизация — Authorization key (base64 client_id:secret).
# scope: GIGACHAT_API_PERS | GIGACHAT_API_CORP | GIGACHAT_API_B2B
# TLS: официальный корневой CA монтируется Compose read-only в контейнер agents.
AGENTS__GIGACHAT_AUTHORIZATION_KEY=
AGENTS__GIGACHAT_SCOPE=GIGACHAT_API_PERS
AGENTS__GIGACHAT_BASE_URL=https://api.giga.chat/v1
AGENTS__GIGACHAT_OAUTH_URL=https://ngw.devices.sberbank.ru:9443/api/v2/oauth
AGENTS__GIGACHAT_VERIFY_SSL=true
AGENTS__GIGACHAT_CA_BUNDLE=/run/certs/gigachat-ca.pem
AGENTS__GIGACHAT_TIMEOUT_SEC=30
AGENTS__GIGACHAT_MODELS_CACHE_TTL_SEC=180
AGENTS__GIGACHAT_TOKEN_SKEW_SEC=60

# Фейловер и ретраи между провайдерами.
# PROVIDER_FALLBACK_ORDER — список через запятую, напр. mws,gigachat,openrouter
AGENTS__PROVIDER_FAILOVER_ENABLED=true
AGENTS__PROVIDER_FALLBACK_ORDER=openai,routerai,gigachat
AGENTS__LLM_RETRY_ATTEMPTS=2
AGENTS__LLM_RETRY_BASE_DELAY_SEC=0.4
AGENTS__LLM_RETRY_MAX_DELAY_SEC=4.0

# Прокси для исходящих вызовов провайдеров (optional).
# PROXY_PROVIDERS — кому применять прокси (CSV). Зарубежные (openrouter/openai) —
# через прокси; российские (routerai/gigachat/mws) — напрямую (через зарубежный
# прокси они не достаются). Пусто → прокси не применяется ни к кому.
AGENTS__PROXY_HOST=
AGENTS__PROXY_PORT=
AGENTS__PROXY_USER=
AGENTS__PROXY_PASS=
AGENTS__PROXY_PROVIDERS=openrouter,openai

# Лимиты диалога и контекста
AGENTS__MAX_TURNS=15
# Предохранитель на выборку истории из БД. Сколько реплик реально влезет — решает
# токенный бюджет окна, поэтому тянем с запасом.
AGENTS__CHAT_HISTORY_MESSAGES_LIMIT=40

# ═══ 9. Голос — Whisper STT (профиль dev, сервис whisper) ═══════════════════
# Локальная STT через сайдкар-сервис. Primary для голоса; при недоступности —
# фолбэк на LLM-провайдера. WHISPER_MODELS — модели, что сайдкар тянет с HuggingFace.
AGENTS__WHISPER_ENABLED=true
AGENTS__WHISPER_URL=http://whisper:8080
AGENTS__WHISPER_DEFAULT_MODEL=base
AGENTS__WHISPER_LANGUAGE=ru
AGENTS__WHISPER_TIMEOUT_SEC=600
# Тарификация локальной STT: ₽/мин × множитель модели (тяжелее модель — дороже).
AGENTS__WHISPER_PRICE_RUB_PER_MIN=0.05
WHISPER_MODELS=base small large-v3-turbo-q5_0

# ═══ 10. Документы — парсинг вложений (сервис opendataloader) ═══════════════
# Сайдкар opendataloader: pdf/docx/xlsx/pptx/rtf/html → markdown СО СТРУКТУРОЙ
# (заголовки, таблицы, списки) вместо плоского текста PyPDF2. Office-форматы сначала
# доводит до PDF через LibreOffice. Fail-open: сайдкар выключен или недоступен →
# бэкенд молча падает на legacy-парсеры, загрузка файлов не ломается.
AGENTS__OPENDATALOADER_ENABLED=true
AGENTS__OPENDATALOADER_URL=http://opendataloader:8080
AGENTS__OPENDATALOADER_TIMEOUT_SEC=180
AGENTS__OPENDATALOADER_MAX_BYTES=20971520
# Потолок текста вложения — страховка от патологии, а НЕ рабочая обрезка: под окно
# модели документ ужимает map-reduce компрессор, и ему нужен ВЕСЬ текст (раньше тут
# было захардкожено 15000 символов, и модель видела лишь начало файла).
# Максимум вложений на одно сообщение (каждое — отдельный LLM-вызов в fan-out).
AGENTS__MAX_ATTACHMENTS_PER_MESSAGE=8
AGENTS__ATTACHMENT_TEXT_MAX_CHARS=400000
AGENTS__UPLOAD_MAX_BYTES=20971520

# ═══ 11. Граф знаний — graphify (сервис graphify) ═══════════════════════════
# Сайдкар graphify: корпус → граф знаний, по которому можно спрашивать.
# code (zip с кодом): tree-sitter AST по 36 языкам, БЕЗ единого вызова LLM.
# docs: семантический проход LLM через наш шлюз — стоит денег, поэтому индексация
# документов тарифицируется явно (шлюз кредиты НЕ списывает, там только auth).
AGENTS__GRAPHIFY_ENABLED=true
AGENTS__GRAPHIFY_URL=http://graphify:8080
AGENTS__GRAPHIFY_TIMEOUT_SEC=900
AGENTS__GRAPHIFY_MAX_BYTES=52428800
AGENTS__GRAPHIFY_MODEL=openrouter:openai/gpt-4o-mini
AGENTS__GRAPH_INDEX_ENABLED=true
AGENTS__GRAPH_INDEX_PRICE_RUB_PER_DOC=0.5
# Сайдкар duckdb: SQL/аналитика по табличным файлам (csv/tsv/parquet/json/xlsx).
# Инструмент agent-а analyze_data гоняет SQL по загруженным пользователем таблицам.
# Fail-open: выключен/недоступен → инструмент отвечает словами, а не роняет ход.
AGENTS__DUCKDB_ENABLED=true
AGENTS__DUCKDB_URL=http://duckdb:8080
AGENTS__DUCKDB_TIMEOUT_SEC=60
# MCP: инструменты чужих серверов. Сами серверы (адрес, секрет, белый список) задаёт
# АДМИН в панели — структурой, а не переменной: адрес из окружения тут был бы пустой
# строкой, а из тела запроса — прямым SSRF во внутреннюю сеть.
# Сайдкар песочницы глазами слоя агентов (квартет соседа). Ключ НЕ дублируем: он один и
# тот же — WORKSPACE_API_KEY выше, compose подставляет его обеим сторонам.
AGENTS__WORKSPACE_ENABLED=true
# 🔴 АВТОСОЗДАНИЕ песочницы треду — ВЫКЛЮЧЕНО. Каждая песочница это контейнер на хосте, а
# их общее число ограничено (WORKSPACE_MAX_WORKSPACES): включать вместе с поднятием потолка.
# Ключ читает ТОЛЬКО backend — сайдкару agents он не пробрасывается.
AGENTS__WORKSPACE_AUTOCREATE=false
AGENTS__WORKSPACE_TTL_SEC=1800
AGENTS__WORKSPACE_URL=http://workspace:8080
AGENTS__WORKSPACE_TIMEOUT_SEC=120
AGENTS__MCP_ENABLED=true
AGENTS__MCP_TIMEOUT_SEC=20
AGENTS__MCP_RESILIENCE_MODE=observe
AGENTS__MCP_CIRCUIT_FAILURE_THRESHOLD=3
AGENTS__MCP_CIRCUIT_COOLDOWN_SEC=60
AGENTS__TOOL_DEDUP_MODE=observe
AGENTS__TOOL_DISCLOSURE_MODE=observe
AGENTS__TOOL_DISCLOSURE_MIN_CANDIDATE_COUNT=15
AGENTS__TOOL_DISCLOSURE_TIMEOUT_SEC=8
AGENTS__TOOL_DISCLOSURE_CANARY_USER_IDS=
AGENTS__WORKFLOW_CATALOG_ENABLED=true
AGENTS__WORKFLOW_CATALOG_COLLECTION=gpthub_workflow_catalog
AGENTS__WORKFLOW_CATALOG_TOP_K=5
AGENTS__WORKFLOW_CATALOG_MIN_SIMILARITY=0.78
AGENTS__WORKFLOW_CATALOG_OUTBOX_LEASE_SEC=120
AGENTS__WORKFLOW_CATALOG_OUTBOX_RETRY_MAX_SEC=3600

# --- workspace: файловая песочница агента (сайдкар с docker.sock) ---
# 🔴 ОБА КЛЮЧА ОБЯЗАТЕЛЬНЫ, сервис без них не стартует. WORKSPACE_API_KEY закрывает ручки
# (открытая ручка сервиса с docker.sock = доступ к хосту из внутренней сети),
# WORKSPACE_OWNER_SECRET подписывает владение песочницей (без подписи угаданный
# workspace_id = чужая файловая система).
WORKSPACE_API_KEY=change-me-workspace-api-key
WORKSPACE_OWNER_SECRET=change-me-workspace-owner-secret-32b
# Separate HMAC secret for the workspace→backend coordinator. It is required
# by both backend and workspace but is never sent to agents, browsers or models.
# Production must source a unique value from its secret manager; do not reuse
# this development placeholder or either workspace ownership/API secret.
WORKSPACE_COORDINATION_SECRET=change-me-workspace-coordination-secret-32b
# Production sidecar mutations require an opaque backend coordination capability.
WORKSPACE_COORDINATION_REQUIRED=true
WORKSPACE_COORDINATOR_URL=http://backend:8000
WORKSPACE_COORDINATOR_TIMEOUT_SEC=2
# Драйвер вычислений. Известен один — docker. Неизвестное имя роняет старт осознанно:
# опечатка не должна давать рантайм слабее заказанного.
WORKSPACE_DRIVER=docker
# Образ изолированной среды выполнения. Он должен содержать git: история файлов и откат
# сохраняются внутри песочницы, поэтому голого python-образа недостаточно.
WORKSPACE_IMAGE=gpthub-workspace-runtime:latest
# Одноразовый LaTeX runtime Document Forge; не запускается как постоянный сервис.
WORKSPACE_DOCUMENT_IMAGE=gpthub-document-runtime:latest
WORKSPACE_DOCUMENT_BUILD_TIMEOUT_SEC=240
WORKSPACE_DOCUMENT_MAX_SOURCE_BYTES=33554432
WORKSPACE_DOCUMENT_MAX_ARTIFACT_BYTES=67108864
WORKSPACE_DOCUMENT_MEMORY_BYTES=1610612736
WORKSPACE_DOCUMENT_PIDS_LIMIT=384
WORKSPACE_DOCUMENT_CPUS=2
# Подпись коммитов, создаваемых агентом внутри песочницы. Это не учётная запись хоста.
WORKSPACE_GIT_AUTHOR=GPTHub Agent <agent@gpthub.local>
# Срок жизни песочницы: контейнер, который никто не удалил, держит память и диск хоста.
WORKSPACE_TTL_SEC=1800
WORKSPACE_HARD_TTL_SEC=14400
# Потолок одного вызова. Жёсткий отдельно от дефолта: без него вызывающий занял бы
# исполнителя на час, а исполнитель общий на всех арендаторов.
WORKSPACE_EXEC_TIMEOUT_SEC=120
WORKSPACE_HARD_EXEC_TIMEOUT_SEC=600
WORKSPACE_MAX_OUTPUT_CHARS=20000
# Потолок числа одновременных песочниц. Общий, а не на арендатора: ресурс хостовой.
WORKSPACE_MAX_WORKSPACES=32
# Тело запроса маленькое: файлы внутрь едут ССЫЛКАМИ, сайдкар качает сам.
WORKSPACE_MAX_BODY_BYTES=4194304
AGENTS__DUCKDB_MAX_BYTES=50331648
# Разбор репозитория по ссылке. Клонировать по произвольному URL — это SSRF, поэтому:
# белый список хостов, только https, архив тянем по HTTPS (git-бинарь не нужен), потолок
# размера проверяется ПО ХОДУ скачивания.
AGENTS__REPO_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org
AGENTS__REPO_MAX_BYTES=52428800
AGENTS__REPO_FETCH_TIMEOUT_SEC=120
# Векторный поиск по документам — вторая половина гибрида. Граф отвечает на РЕЛЯЦИОННЫЕ
# вопросы (что с чем связано), эмбеддинги — на «что там написано про X». Одно другое не
# заменяет: graphify прямо говорит о себе, что он НЕ векторный индекс.
# ⚠️ Коллекция Qdrant жёстко привязана к размерности: сменить эмбеддер = пересоздать её.
AGENTS__VECTOR_SEARCH_ENABLED=true
AGENTS__QDRANT_URL=http://qdrant:6333
AGENTS__DOC_VECTOR_COLLECTION=gpthub_docs
AGENTS__DOC_EMBEDDER_MODEL=gigachat:Embeddings
AGENTS__DOC_EMBEDDER_DIM=1024
AGENTS__DOC_CHUNK_TOKENS=700
AGENTS__DOC_CHUNK_OVERLAP_TOKENS=100
AGENTS__DOC_VECTOR_TOP_K=5

# ═══ 12. Память — Mem0 / MemOS (профиль memos) ══════════════════════════════
# MEMORY_PROVIDER: auto (mem0→memos→noop) | mem0 | memos | noop
AGENTS__MEMORY_PROVIDER=auto

# Mem0 (cloud) — долговременная память пользователя
AGENTS__MEM0_API_KEY=
AGENTS__MEM0_APP_ID=gpthub

# MemOS (self-hosted, профиль compose `memos`). Base URL: http://memos:8000
# (MEMOS=1 ./docker/run.sh). Пусто → память только в рамках сессии.
AGENTS__MEMOS_BASE_URL=
AGENTS__MEMOS_API_KEY=
AGENTS__MEMOS_MEM_CUBE_ID=gpthub-{user_id}
AGENTS__MEMOS_TIMEOUT_SEC=15
AGENTS__MEMOS_ASYNC_MODE=sync
# Эмбеддер MemOS со стороны БЭКЕНДА (редактируется в админке; memos читает его через
# /api/analytics/memos-embedder). Должен совпадать с MEMOS_EMBEDDER_MODEL ниже —
# та переменная задаёт стартовое значение самому контейнеру memos.
# Смена модели/размерности → ПОЛНЫЙ сброс памяти MemOS (коллекция Qdrant привязана
# к размерности) + рестарт memos.
AGENTS__MEMOS_EMBEDDER_MODEL=openrouter:openai/text-embedding-3-small
AGENTS__MEMOS_EMBEDDER_DIM=1536

# Стек MemOS (сервисы memos/neo4j/qdrant). LLM/эмбеддинги MemOS идут через ЕДИНЫЙ
# шлюз backend (http://backend:8000/v1, ключ AGENTS__LLM_GATEWAY_API_KEY ниже) —
# общий мульти-провайдер с failover. Модели в формате "<provider>:<model>".
# NEO4J_PASSWORD в prod — сильный.
NEO4J_PASSWORD=change-me-strong-password
MEMOS_CHAT_MODEL=openrouter:openai/gpt-4o-mini
MEMOS_MEMRADER_MODEL=openrouter:openai/gpt-4o-mini
MEMOS_EMBEDDER_MODEL=openrouter:openai/text-embedding-3-small
MEMOS_EMBEDDING_DIMENSION=1536

# ═══ 13. Deep Research — LDR (профиль ldr) ══════════════════════════════════
# DEEP_RESEARCH_PROVIDER: auto (ldr если доступен, иначе нативный) | ldr | native
AGENTS__DEEP_RESEARCH_PROVIDER=auto

# LDR REST endpoint. Self-hosted: http://ldr:5000 (LDR=1 ./docker/run.sh).
# Пусто → нативный deep_research. Сервис-аккаунт (одноразовый bootstrap):
# LDR_APP_ALLOW_REGISTRATIONS=true → регистрация через http://localhost:5000 →
# вписать сюда LDR_USERNAME/PASSWORD → вернуть LDR_APP_ALLOW_REGISTRATIONS=false.
AGENTS__LDR_BASE_URL=
AGENTS__LDR_USERNAME=
AGENTS__LDR_PASSWORD=
AGENTS__LDR_MODEL=openrouter:openai/gpt-4o-mini
AGENTS__LDR_SEARCH_ENGINES=searxng
AGENTS__LDR_STRATEGY=langgraph-agent
AGENTS__LDR_ITERATIONS=3
AGENTS__LDR_TIMEOUT_SEC=240
AGENTS__LDR_POLL_INTERVAL_SEC=3

# OpenAI-совместимый ЕДИНЫЙ шлюз мульти-провайдера: LDR и MemOS ходят за LLM/эмбеддинги
# на http://agents:8090/v1 с этим ключом. Шлюз живёт в САЙДКАРЕ — он владеет
# провайдерами; backend шлюзом быть перестал (двух шлюзов с разным представлением о
# живых провайдерах быть не должно).
# Модель как "<provider>:<model>" (openrouter:.. | gigachat:.. | mws:.. | routerai:..).
# Обязателен для self-hosted memos/ldr (иначе шлюз отдаёт 404).
AGENTS__LLM_GATEWAY_ENABLED=true
AGENTS__LLM_GATEWAY_API_KEY=change-me-gateway-key

# ── Сайдкар агентного движка (сервис `agents`, профиль `agents`) ──────────────
# ВСЕ прогоны агента идут через него: домен удалён из backend, in-process пути нет.
# ⚠️ `http` — ЕДИНСТВЕННОЕ принимаемое значение, отката НЕТ. Раньше здесь было
# написано, что `inprocess` «оставлен как аварийный тумблер»: это неправда и в
# инциденте стоило бы времени — фабрика движка отвергает его явной ошибкой
# (engine_factory.py), потому что доменного кода в backend больше нет физически.
# Аварийное переключение означало бы откат кода, а не смену переменной.
AGENTS__ENGINE_MODE=http
AGENTS__SIDECAR_URL=http://agents:8090
# Потолок на ОДИН прогон агента: сюда укладываются мульти-интент, инструменты и
# длинный стрим. Меньше — рвётся длинный ответ; в него же упирается отмена.
AGENTS__SIDECAR_TIMEOUT_SEC=600
# Потолок ТЕЛА запроса к сайдкару. Его не было ни на одной ручке: uvicorn читает тело
# целиком в память, а сайдкар долгоживущий и один на всю платформу — один большой
# запрос клал бы обработку у всех. Опаснее всего на `/run`: туда едут история, память,
# резюме и текст вложений, то есть тело растёт вместе с активностью пользователя.
AGENTS__MAX_BODY_BYTES=67108864
# Канареечный список user_id (CSV): эти пользователи идут в сайдкар даже при
# ENGINE_MODE=inprocess. Пусто = канарейки нет.
AGENTS__ENGINE_CANARY_USER_IDS=

# Стек LDR (сервисы ldr/searxng). LDR берёт LLM из шлюза (AGENTS__LLM_GATEWAY_API_KEY).
LDR_LLM_MODEL=openrouter:openai/gpt-4o-mini
LDR_APP_ALLOW_REGISTRATIONS=false

# ═══ 14. Роутинг · контекст · надёжность ════════════════════════════════════
# Мульти-интент + ре-роут (по умолчанию: ре-роут вкл., декомпозиция выкл.)
AGENTS__MULTI_INTENT_ENABLED=false
AGENTS__MAX_SUBTASKS=3
AGENTS__REROUTE_ON_FAILURE_ENABLED=true
AGENTS__SUBTASK_SYNTHESIS_MAX_TOKENS=1200
# Длина ОТВЕТА модели. Это же значение резервируется под ответ при расчёте бюджета
# контекста (CONTEXT_OUTPUT_RESERVE=0 → берём отсюда), поэтому оно влияет на то,
# сколько окна остаётся под входной контекст. Обрыв по лимиту → авто-продолжение.
AGENTS__CHAT_MAX_TOKENS=4096
AGENTS__CHAT_MAX_CONTINUATIONS=2
AGENTS__CHAT_MAX_PROMPT_TOKENS_PER_RUN=40000
# Единый протокол контекста. Бюджет ВЫВОДИТСЯ из реального окна выбранной модели:
#   usable = window*SAFETY_MARGIN - место_под_ответ - оверхед_промпта
# 128k-модель получает ~106k контекста, 32k-я ~22k — один протокол, разный масштаб.
# 0 = считать от окна модели (штатно). >0 = жёсткий потолок сверху (контроль стоимости).
AGENTS__CONTEXT_TOKEN_BUDGET=0
AGENTS__CONTEXT_SAFETY_MARGIN=0.85
AGENTS__CONTEXT_OUTPUT_RESERVE=0
AGENTS__CONTEXT_PROMPT_OVERHEAD=1000
AGENTS__CONTEXT_DEFAULT_WINDOW=32768
# Веса секций. Секции, которых нет в запросе, свою долю не получают — вес
# перенормируется по присутствующим (нет файла → его доля уходит истории и памяти).
AGENTS__CONTEXT_BUDGET_HISTORY=0.30
AGENTS__CONTEXT_BUDGET_MEMORY=0.15
AGENTS__CONTEXT_BUDGET_PLAN=0.10
AGENTS__CONTEXT_BUDGET_FILES=0.35
AGENTS__CONTEXT_BUDGET_FACTS=0.05
AGENTS__CONTEXT_BUDGET_SUMMARY=0.05
# Крупные источники (документ/транскрипт) СЖИМАЮТСЯ под свою долю, а не режутся.
AGENTS__CONTEXT_COMPRESSION_ENABLED=true
# Доля usable, при которой запускается авто-компактизация диалога.
AGENTS__COMPACTION_THRESHOLD=0.85
AGENTS__HISTORY_SUMMARY_ENABLED=true
AGENTS__SUMMARY_TRIGGER_MESSAGES=12
AGENTS__SUMMARY_KEEP_RECENT=6
AGENTS__SUMMARY_MAX_TOKENS=400
# ⚠️ ОБЩИЙ дедлайн прогона агента. Обязан лежать МЕЖДУ самой долгой внутренней
# операцией (AGENTS__LDR_TIMEOUT_SEC=240 у deep research) и внешним таймаутом backend
# (AGENTS__SIDECAR_TIMEOUT_SEC=600): меньше внутренней — дорогой режим не успеет
# завершиться никогда, больше внешней — backend оборвёт первым и дедлайн не сработает.
# Здесь стояло 90 — значение из тех времён, когда переменная до сайдкара не доезжала
# вовсе и он жил на код-дефолте 570; включив доставку, 90 убило бы deep research.
AGENTS__RUN_TIMEOUT_SEC=570

# Ручки, до сайдкара раньше не доезжавшие вовсе (белый список compose отстал от настроек).
# Значения — прежние код-дефолты, то есть поведение не меняется; теперь их можно крутить.
AGENTS__CONTEXT_BUDGET_KNOWLEDGE=0.15
AGENTS__DOC_EMBEDDER_MAX_TOKENS=480
AGENTS__INSTRUCTIONS_MAX_CHARS=3000
AGENTS__MAX_CONTEXT_CHARS=150000
AGENTS__PERSONA_MAX_TOKENS=800
AGENTS__PLAN_STEP_EXECUTION_ENABLED=false
AGENTS__SEARCH_ENGINE_TIMEOUT_SEC=5.0
AGENTS__TOKEN_BUDGET_ENABLED=true

# Оркестратор режима «Авто»: ОДИН контекстный вызов решает и маршрут, и стратегии
# (план, декомпозиция, поиск-инструмент) вместо категорийного роутера на одну метку.
# Выключение возвращает прежнее поведение целиком. ⚠️ Читает его САЙДКАР, поэтому
# переменная обязана быть в блоке `agents` в compose, а не только у backend.
AGENTS__AUTO_ORCHESTRATOR_ENABLED=true
# Режимы, которые «Авто» не запускает сам, а предлагает кнопкой: они дорогие
# (deep_research ≈2500 кр., pptx_gen ≈1667 кр.), и списание за неспрошенное — жалоба.
AGENTS__AUTO_CONFIRM_MODES=deep_research,pptx_gen,research_deck
# Сколько живёт предложение дорогого режима (сек). Отсчёт СЕРВЕРНЫЙ; молчание = отказ,
# автозапуск по таймауту списал бы тысячи кредитов у отошедшего от экрана.
AGENTS__MODE_OFFER_TTL_SEC=30

# ═══ 15. Биллинг — экономика кредитов ═══════════════════════════════════════
# Тарифы/паки/лимиты (plan_credits, plan_prices_rub, topup_packs, rate_limits,
# class_prices_rub_per_1k, tool_surcharge_rub) — дефолты в settings.py:BillingConfig.
# credit_unit_rub — ₽ за 1 кредит; margin/min_margin — наценка и нижняя планка;
# cost_guard_*_events — число fallback/budget-stop за 24ч для warning/critical;
# free_plan_credits — месячный пакет free; default_price_* — fallback ₽/1K токенов;
# abuse_* — детекция аномальной скорости трат.
BILLING__CREDIT_UNIT_RUB=0.01
BILLING__MARGIN_MULTIPLIER=2.5
BILLING__MIN_MARGIN=2.0
BILLING__COST_GUARD_WARNING_EVENTS=1
BILLING__COST_GUARD_CRITICAL_EVENTS=5
BILLING__COMPLEXITY_FACTOR_COMPLEX=1.15
BILLING__MIN_CREDITS_PER_REQUEST=1
BILLING__RESERVE_SAFETY=1.2
BILLING__FREE_PLAN_CREDITS=10000
BILLING__DEFAULT_PRICE_IN_RUB_PER_1K=2.0
BILLING__DEFAULT_PRICE_OUT_RUB_PER_1K=6.0
BILLING__ABUSE_SPEND_THRESHOLD_CREDITS=200000
BILLING__ABUSE_SPEND_WINDOW_SECONDS=3600

# ═══ 16. Платежи — провайдер-агностик ═══════════════════════════════════════
# PROVIDER: mock | yookassa. WEBHOOK_SECRET обязателен при provider=mock (иначе
# вебхуки принимаются без проверки подписи — кран бесплатных кредитов); для
# yookassa не нужен. YooKassa: заполнить SHOP_ID/SECRET_KEY при provider=yookassa.
PAYMENTS__PROVIDER=mock
PAYMENTS__WEBHOOK_SECRET=change-me-any-nonempty-string-for-mock
PAYMENTS__SUCCESS_URL=http://localhost:3000/billing/success
PAYMENTS__CANCEL_URL=http://localhost:3000/billing
PAYMENTS__YOOKASSA_SHOP_ID=
PAYMENTS__YOOKASSA_SECRET_KEY=
# --- Фискализация 54-ФЗ (чеки ЮKassa) ---
# RECEIPT_ENABLED=true → в платёж кладутся данные чека, ЮKassa регистрирует фискальный
# чек и сама шлёт его покупателю на email. Включать ТОЛЬКО когда в кабинете ЮKassa
# подключены «Чеки от ЮKassa» и реквизиты ниже верны для вашего юрлица (иначе чек
# невалиден). При AUTH__AUTH_MODE=prod пустой ключ шлюза уже роняет старт — здесь же
# по умолчанию ВЫКЛ, чтобы dev/mock не пытался фискализировать.
PAYMENTS__RECEIPT_ENABLED=false
# Ставка НДС (тег 1199): 1=без НДС, 2=0%, 3=10%, 4=20%, 5=10/110, 6=20/120.
# ЗАВИСИТ от вашей системы налогообложения — уточните у бухгалтера (УСН обычно 1).
PAYMENTS__RECEIPT_VAT_CODE=1
# Предмет расчёта (тег 1212): доступ к сервису/кредитам = service.
PAYMENTS__RECEIPT_PAYMENT_SUBJECT=service
# Способ расчёта (тег 1214): полная оплата сразу = full_payment.
PAYMENTS__RECEIPT_PAYMENT_MODE=full_payment
# СНО (тег 1055): нужна лишь для СТОРОННИХ касс с несколькими СНО; Чеки от ЮKassa
# игнорируют — оставляйте 0 (не передаётся).
PAYMENTS__RECEIPT_TAX_SYSTEM_CODE=0

# ═══ 17. Почта — SMTP подтверждение email ═══════════════════════════════════
# Порт 1127 = implicit TLS (USE_TLS=true); 1126 = STARTTLS (false). LOGIN/PASSWORD —
# секреты SMTP-провайдера (напр. Selectel). FROM_ADDRESS — ящик на подтверждённом
# домене (нужны DNS-владение + SPF/DKIM). ENABLED=false → код только в логах backend.
MAIL__ENABLED=false
MAIL__HOST=smtp.mail.selcloud.ru
MAIL__PORT=1127
MAIL__USE_TLS=true
MAIL__LOGIN=
MAIL__PASSWORD=
MAIL__FROM_ADDRESS=no-reply@incellcorp.ru
MAIL__FROM_NAME=GPTHub
MAIL__CODE_LENGTH=6
MAIL__CODE_TTL_SECONDS=600

# ═══ 18. Админ-панель ═══════════════════════════════════════════════════════
ADMIN__SETTINGS_OVERLAY_TTL_SEC=30
ADMIN__ADMIN_ROLE_CACHE_TTL_SEC=30

# ═══ 19. Уведомления — жизненный цикл аккаунта ══════════════════════════════
# Сервисные письма (подписка истекает, кредиты на исходе, платёж не прошёл) — это
# состояние аккаунта, а не реклама. Реактивация («давно не заходили») — реклама, и она
# уходит ТОЛЬКО при отдельном согласии: согласие на обработку ПДн рекламу не покрывает
# (ФЗ «О рекламе», ст. 18). Отписка гасит ВСЁ, включая сервисные.
NOTIFICATIONS__ENABLED=true
NOTIFICATIONS__APP_URL=https://gpthub.ru
NOTIFICATIONS__SUBSCRIPTION_NOTICE_DAYS=3
NOTIFICATIONS__LOW_CREDITS_THRESHOLD=0.1
NOTIFICATIONS__IDLE_DAYS=30
# Не больше N писем за окно, даже если сработало несколько триггеров сразу.
NOTIFICATIONS__MAX_PER_WINDOW=1
NOTIFICATIONS__FREQUENCY_WINDOW_DAYS=7

# =============================================================================
# Внутренние ручки сайдкаров (имена КОНТЕЙНЕРНЫЕ)
# =============================================================================
# ⚠️ Это не дубли переменных выше. У сайдкаров ДВА набора имён, и их легко спутать:
#   * `AGENTS__<СЕРВИС>_*` — то, что читает КЛИЕНТ в backend/agents (адрес, таймаут
#     вызова, включён ли инструмент). Они описаны в своих разделах выше;
#   * имена ниже — то, что читает САМ сайдкар внутри контейнера. compose
#     переименовывает их на границе (`AGENTS__GRAPHIFY_MAX_BYTES` → `GFY_MAX_BYTES`).
#
# Дефолты живут в коде сайдкара (как у backend), а ЭТОТ раздел — единственный
# ответ на вопрос «какие вообще есть ручки». Поэтому он не справка, а обязательство:
# `scripts/check_settings_manifest.py` роняет CI, если сайдкар читает переменную,
# которой здесь нет. Раскомментируйте нужное, чтобы переопределить на машине.
#
# Почему это вообще выписано: часть этих ручек не была объявлена НИГДЕ — читалась
# кодом, но не задавалась ни здесь, ни в compose. Среди них оказались защитные
# лимиты (потолки tar-бомбы, размер аудио), то есть подкрутить защиту без
# пересборки образа было нельзя. Сверку держит scripts/check_settings_manifest.py.

# --- duckdb: SQL по табличным файлам ---
# DUCKDB_MAX_ROWS=200              # строк в ответе по умолчанию
# DUCKDB_HARD_MAX_ROWS=2000        # жёсткий потолок (max_rows приходит из запроса)
# DUCKDB_MEMORY_LIMIT=512MB        # память DuckDB на запрос, защита от OOM
# DUCKDB_MAX_BODY_BYTES=67108864   # потолок тела запроса (файлы едут base64)
# DUCKDB_MAX_XLSX_ROWS=100000      # потолок строк при конвертации xlsx → csv
# DUCKDB_QUERY_TIMEOUT_SEC=45      # СЕРВЕРНЫЙ дедлайн SQL; строго меньше клиентского
#                                  # (AGENTS__DUCKDB_TIMEOUT_SEC=60). Раньше его не было
#                                  # вовсе: клиент уходил, а сервер продолжал считать.

# --- graphify: корпус → граф знаний ---
# GFY_GRAPHS_DIR=/graphs           # каталог с графами (том контейнера)
# GFY_MODEL=                       # модель для именования сообществ; пусто → без LLM
# GFY_MAX_BYTES=52428800           # потолок присланного архива
# GFY_BUILD_BUDGET_SEC=840         # БЮДЖЕТ на весь запрос, не на шаг: сборка делает до
#                                  # четырёх вызовов CLI подряд, и поштучные 900 с давали
#                                  # до 3600 с при клиентских 900.
# GFY_MAX_FILES=20000              # ЗАЩИТА ОТ TAR-БОМБЫ: файлов в архиве
# GFY_MAX_UNPACKED_BYTES=524288000 # ЗАЩИТА ОТ TAR-БОМБЫ: размер после распаковки

# --- opendataloader: вложения → структурный markdown ---
# ODL_MAX_BYTES=20971520           # потолок вложения
# ODL_LO_TIMEOUT_SEC=70            # дедлайн конвертации через LibreOffice
# ODL_PARSE_TIMEOUT_SEC=95         # дедлайн разбора PDF (сумма с LO < клиентских 180)
# ODL_SOFFICE=soffice              # бинарь LibreOffice
# ODL_MAX_SHEET_ROWS=2000          # обрезка листа таблицы

# --- whisper: локальный STT ---
# WHISPER_MODELS_DIR=/models       # каталог с ggml-весами (том контейнера)
# WHISPER_CLI=whisper-cli          # бинарь whisper.cpp
# WHISPER_DEFAULT_MODEL=base       # модель, если запрос её не указал
# WHISPER_THREADS=4                # потоков декодирования
# WHISPER_MAX_BYTES=26214400       # потолок размера аудио
# WHISPER_FFMPEG_TIMEOUT_SEC=120   # дедлайн перекодирования в wav
# WHISPER_TRANSCRIBE_TIMEOUT_SEC=420  # дедлайн распознавания; сумма с ffmpeg (540) строго
#                                  # меньше клиентского AGENTS__WHISPER_TIMEOUT_SEC=600

# --- сайдкар video (агент смотрит ролик) ---------------------------------------------
# 🔴 ВЫКЛЮЧЕН по умолчанию, в отличие от соседей. Просмотр ролика — самая дорогая
# способность после ресёрча: сотня кадров переезжает в контекст КАЖДОГО следующего
# сообщения треда. Включать осознанно, вместе с решением о тарифе.
AGENTS__VIDEO_ENABLED=false
AGENTS__VIDEO_URL=http://video:8080
# КЛИЕНТСКИЙ дедлайн: строго БОЛЬШЕ серверного (VIDEO_WATCH_TIMEOUT_SEC=420), иначе клиент
# уходит раньше, чем сервис успевает ответить отказом, и причина теряется.
AGENTS__VIDEO_TIMEOUT_SEC=480
# Ключ сайдкара просмотра. Пустой ключ — ОШИБКА СТАРТА сервиса: открытая ручка означает,
# что кто угодно качает что угодно нашими руками и нашим каналом.
VIDEO_API_KEY=change-me-video-api-key
# Потолки сайдкара. Проверяются ДО вызова ffmpeg: восьмичасовая трансляция иначе занимает
# процессор и диск одним запросом.
VIDEO_MAX_DURATION_SEC=7200
VIDEO_MAX_DOWNLOAD_BYTES=2147483648
VIDEO_WATCH_TIMEOUT_SEC=420
