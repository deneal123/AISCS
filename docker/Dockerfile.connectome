FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 NUMBA_CACHE_DIR=/tmp/numba
WORKDIR /prepare
COPY tools/connectome/requirements.txt ./requirements.txt
RUN pip install --no-cache-dir -r requirements.txt
COPY tools/connectome ./tools/connectome
COPY scripts/prepare_connectome.py ./scripts/prepare_connectome.py
RUN useradd --create-home --uid 10001 generator && mkdir /data && chown generator /data
USER generator
ENTRYPOINT ["python", "scripts/prepare_connectome.py"]
CMD ["--output", "/data"]
