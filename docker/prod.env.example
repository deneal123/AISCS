# Public AISCS production settings; not a replacement for the full .env.example.
# The ignored .env.prod is derived from the GPTHub production environment.
APP_DOMAIN=aiscs.incellcorp.ru
SERVICE__APP_DOMAIN=aiscs.incellcorp.ru
SERVICE__APPLICATION_PROFILE=simulation
REACT_APP_APPLICATION_PROFILE=simulation
AUTH__AUTH_MODE=prod
AUTH__DEV_MODE=false
SERVICE__REACT_APP_API_BASE_URL=
SERVICE__REACT_APP_WS_BASE_URL=
CORS__ALLOW_ORIGINS=["https://aiscs.incellcorp.ru"]
# Existing edge nginx terminates the public origin on :443, forwards to :8447.
PUBLIC_HTTPS_PORT=443
NGINX_PUBLISH_HTTPS=127.0.0.1:8447
STORAGE__BACKEND=minio
MINIO__ENDPOINT=s3.ru-7.storage.selcloud.ru
MINIO__PUBLIC_ENDPOINT=https://s3.ru-7.storage.selcloud.ru
MINIO__REGION=ru-7
MINIO__SECURE=true
MINIO__BUCKET=aiscs
MINIO__ACCESS_KEY=
MINIO__SECRET_KEY=
GENERATOR_URL=http://generator:8090
GENERATOR_TOKEN=
