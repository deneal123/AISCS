# Артефакты интерпретатора. Домен импортируется прямо из рабочего дерева (в dev оно
# смонтировано в контейнер), поэтому __pycache__ появляется здесь при каждом прогоне.
# Без этого файла они попадали в индекс: 93 .pyc были закоммичены.
__pycache__/
*.py[cod]
*.egg-info/

# Виртуальное окружение и кэш линтера. Формально их прячут собственные вложенные
# .gitignore, которые пишут uv и ruff, — но полагаться на чужой служебный файл
# для защиты индекса не стоит.
.venv/
.ruff_cache/

# Тестовый мусор
.pytest_cache/
.coverage
htmlcov/

# Граф знаний (`make graph GRAPH_TARGET=agents`) — 19 МБ дев-артефактов.
# Корневой .gitignore сюда НЕ достаёт: для суперпроекта сабмодуль это гитлинк.
graphify-out/

# Локальный снимок dirty tree для отчёта S23. В Git попадает только stdlib-скрипт,
# исходники и хэши текущих незакоммиченных hunks остаются на машине исполнителя.
.s23-local/
