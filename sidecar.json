{
  "name": "aspa-publications-sidecar",
  "mcp_name": "aspa-publications",
  "version": "1.0.0",
  "uses_biber": false,
  "registry": "data/publications.json",
  "outline": "docs/outline.md",
  "source_roots": ["conference", "documents"],
  "snapshot_paths": ["data", "conference", "documents", "docs", "README.md", "TODO.md"],
  "placeholder_patterns": ["\\\\ResultPending", "\\bTODO\\b", "\\bBLOCKED\\b"]
  ,"allowed_target_constructs": ["construct_boundaries", "nociceptive_response", "human_pain_self_report", "human_experimental_nociception", "ecap_like_observation", "clinical_scs_response", "simulation_dynamics", "methodological_transfer"]
}
